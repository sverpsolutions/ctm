{
  "name": "company-task-management",
  "version": "1.0.0",
  "description": "Company Important Date & Task Management System",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "postinstall": "npm --prefix backend install --omit=optional",
    "build": "node -e \"console.log('Production build dist already prepared.')\"",
    "build:all": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "start": "node server.js",
    "db:setup": "cd backend && npm run db:setup",
    "db:seed": "cd backend && npm run db:seed"
  },
  "dependencies": {
    "typescript": "^5.6.2"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  },
  "keywords": [
    "task-management",
    "important-dates",
    "reminders",
    "sql-server",
    "react",
    "typescript"
  ],
  "author": "Enterprise Architecture Team",
  "license": "ISC"
}
