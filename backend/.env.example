PORT=5000
NODE_ENV=development

# Database Engine: sqlite, mysql, or mssql
DB_ENGINE=sqlite

# MySQL/MariaDB Configuration (used when DB_ENGINE=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=company_task_db

# SQL Server Configuration (used when DB_ENGINE=mssql)
DB_SERVER=localhost\SQLEXPRESS
DB_DATABASE=CompanyTaskDB
DB_TRUSTED_CONNECTION=true
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# For SQL Authentication (if not using Windows Auth):
DB_USER=sa
DB_PASSWORD=YourStrongPasswordHere!
DB_PORT=1433

# JWT Secret & Expiry
JWT_SECRET=change-this-to-a-strong-random-secret
JWT_EXPIRES_IN=7d

# File Upload Settings
UPLOAD_DIR=uploads
MAX_FILE_SIZE=25000000

# Client Application URL (for CORS)
CLIENT_URL=http://localhost:5173

# Platform Super Admin (sverpadmin) initial password
PLATFORM_ADMIN_PASSWORD=ChangeThisOnFirstLogin!2026
